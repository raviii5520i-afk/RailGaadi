# RailGaadi Environment Variables
# Copy this file to .env.local and fill in your actual values

# RailRadar API (Live Train Tracking)
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# OpenWeather API
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenTopography API (Elevation data)
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# MapTiler (Public key - can be included in client, restrict by domain)
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_public_key_here

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# Optional: Enable mock data mode (no real API calls)
NEXT_PUBLIC_MOCK_MODE=true
